{
  "name": "@binance/agentic-wallet",
  "version": "1.9.0",
  "description": "CLI wallet tool for payments and crypto",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "baw": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js --dev",
    "build:prod": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "watch:dev": "node scripts/build.js --watch --dev",
    "dev": "node scripts/build.js --watch --dev",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "wallet",
    "cli",
    "crypto",
    "payments"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "20.19.25",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "bignumber.js": "^9.3.1",
    "@github/keytar": "7.10.6",
    "@noble/hashes": "2.0.1",
    "chalk": "5.3.0",
    "commander": "12.0.0",
    "open": "11.0.0",
    "ora": "8.0.0",
    "qrcode": "1.5.4",
    "string-width": "7.2.0",
    "zod": "3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

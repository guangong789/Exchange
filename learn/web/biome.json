{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!package-lock.json",
      "!dist",
      "!node_modules",
      "!test-results",
      "!playwright-report",
      "!.sites-runtime"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "rules": { "preset": "recommended" } }
}
